//Exercício 4
class Program
{
    static void Main()
    {
        Console.WriteLine("Quanto é o valor você deseja investir?");
        decimal valorinicial = decimal.Parse(Console.ReadLine());
        Console.WriteLine("Qual é a taxa de juros que você deseja aplicar?");
        decimal taxajuros = decimal.Parse(Console.ReadLine());
        Console.WriteLine("Qual a quantidade de meses que você deixará rendendo?");
        int numerodemeses = int.Parse(Console.ReadLine());
        decimal percentualjuros = (taxajuros / 100)+1;
        decimal quadradojuros = 1;
        decimal valorfinal = 0;
        for (int i = 1; i <= numerodemeses; i++)
        {
           quadradojuros = quadradojuros * percentualjuros;
            Console.WriteLine($"Estamos no mês {i} deseja Sacar uma quantidade de dinheiro?");
            string escolha = Console.ReadLine();
           if(escolha=="Sim" )
            {
                Console.WriteLine("Qual o valor que deseja sacar?");
                decimal saque = decimal.Parse(Console.ReadLine());
                valorfinal = valorinicial * quadradojuros;
                valorfinal = valorfinal - saque;
                quadradojuros = 1;
            }
        }
        valorfinal = valorfinal * quadradojuros;
        Console.WriteLine($"O valor final da sua aplicação é:{valorfinal:F2}R$");
    }
}
