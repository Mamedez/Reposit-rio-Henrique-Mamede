        decimal percentualjuros = (taxajuros / 100)+1;
        decimal quadradojuros = 1;
        decimal rendaacumulada = valorinicial;
        for (int i = 1; i <= numerodemeses; i++)
        {
           quadradojuros = quadradojuros * percentualjuros;
           decimal rendamensal = (quadradojuros * valorinicial) - valorinicial;
           rendaacumulada = rendamensal + rendaacumulada;
           Console.WriteLine($"Sua renda no mes {i} foi: {rendamensal:F2}R$");
